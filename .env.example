# Copy this file to `.env` and fill it in. Never commit the real .env.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Right-click your server icon in Discord -> Copy Server ID
# (needs Settings -> Advanced -> Developer Mode turned on).
# Slash commands appear instantly in this server instead of taking ~1 hour.
GUILD_ID=000000000000000000

# Must match the password in lavalink/application.yml
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass

# Seconds of silence before the bot leaves. 300 = 5 minutes. /stay overrides it.
INACTIVE_TIMEOUT=300
